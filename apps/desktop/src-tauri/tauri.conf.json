{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Capriole",
  "version": "0.3.1",
  "identifier": "app.capriole.Capriole",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../capriole run dev",
    "beforeBuildCommand": "npm --prefix ../capriole run build && node scripts/frontend.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Capriole",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis"],
    "publisher": "Bobolar Ltd",
    "homepage": "https://capriole.app",
    "license": "0BSD",
    "copyright": "Bobolar Ltd",
    "category": "Productivity",
    "shortDescription": "Edit, sign and fill in PDF files, on your computer",
    "longDescription": "Capriole edits PDF files on your computer: pages, text, images, annotations, forms, attachments, redaction, PDF/A, and digital signatures with a .p12 file or a smart card. Free, no account; files never leave the device.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh",
        "languages": ["English", "Italian", "French", "German", "Spanish"]
      }
    }
  }
}
