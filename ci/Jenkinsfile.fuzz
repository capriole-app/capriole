// Jenkins pipeline — capriole fuzzing campaign (manual, long-running).
//
// Not part of the per-push CI: it builds the libFuzzer targets in the CI image and runs
// scripts/fuzz_campaign.sh for HOURS of wall-clock time with WORKERS fuzzers at a time, at the lowest
// CPU priority. The working corpora live in the job workspace (fuzz/corpus-work) and grow from one
// campaign to the next. Crashing inputs are archived; any finding fails the build.
//
// The Jenkins host is shared (6 cores, ~6 GB of free RAM, no swap, 2 executors). The campaign takes
// one executor and is capped at container level, not only by nice: --cpus = WORKERS, --memory =
// MEMORY for the whole container, 1 GB per fuzzer (the measured peak is ~550 MB). Without swap, an
// uncapped fuzzer that ran away could get CI jobs or services killed by the kernel's OOM killer.

pipeline {
  agent none

  parameters {
    string(name: 'HOURS', defaultValue: '24', description: 'Wall-clock duration of the campaign, in hours')
    string(name: 'WORKERS', defaultValue: '2', description: 'Fuzzers running at the same time (= CPU cores used)')
    string(name: 'MEMORY', defaultValue: '3g', description: 'Memory cap of the whole container (docker --memory)')
  }

  options {
    disableConcurrentBuilds()
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '20'))
    timeout(time: 30, unit: 'HOURS')
  }

  stages {
    stage('Fuzz campaign') {
      agent {
        dockerfile {
          filename 'ci/Dockerfile'
          dir '.'
          args "-e HOME=/tmp --cpus=${params.WORKERS} --memory=${params.MEMORY} --memory-swap=${params.MEMORY}"
        }
      }
      environment {
        CMAKE_BUILD_PARALLEL_LEVEL = "${params.WORKERS}"
        RSS_LIMIT_MB = '1024'
      }
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          cmake --preset fuzz
          cmake --build --preset fuzz
          scripts/fuzz_campaign.sh "$HOURS" "$WORKERS"
        '''
      }
      post {
        always {
          archiveArtifacts artifacts: 'fuzz/campaign/**', allowEmptyArchive: true
        }
      }
    }
  }
}
