# The web app's own server, inside the capriole-web image: static files and their headers. In front of
# it, on contabo-b, the shared gateway (Caddyfile.capriole.snippet) does TLS, HSTS and the domain.
# Self-hosted, the image works the same behind any proxy that terminates TLS.
{
	admin off
	auto_https off
	persist_config off
	# The gateway in front says who the client is (X-Forwarded-For): believed from a private address
	# only, and passed on to the reports' service, which caps reports per sender (deploy/reports).
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	root * /srv
	encode zstd gzip

	# csp.caddy: the Content-Security-Policy with the hashes of this build's inline scripts (csp.mjs).
	import /etc/caddy/csp.caddy
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Cross-Origin-Opener-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		-Server
	}

	# Files whose names carry their hash never change: kept a year. The rest (the page, the resource
	# pack, the licences) is asked again each time, answered 304 while unchanged.
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@mutable not path /_app/immutable/*
	header @mutable Cache-Control "no-cache"

	# Counting visits, anonymously (stats.sh): one line per opening of the page («page»), and one per start
	# of the app («start»: the first screen's logo, which only a browser running the app asks for — and
	# asks again on each visit, no-cache — while the scanners a new domain draws fetch the page alone).
	# In each line only the time, the method, the status, that label and the browser's name (to tell
	# robots apart): no address, no other header, no path, all taken away before the line is written.
	# In /logs, a volume (docker-compose.yml), so that a new deploy does not lose the count.
	@page path / /index.html
	@start path /logo-light.svg
	@uncounted not path / /index.html /logo-light.svg
	log_skip @uncounted
	log_append @page kind page
	log_append @start kind start
	log_append ua {http.request.header.User-Agent}
	log {
		output file /logs/access.log {
			roll_size 10MiB
			roll_keep 10
			roll_uncompressed
		}
		format filter {
			wrap json {
				time_format rfc3339
			}
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>proto delete
			request>host delete
			request>uri delete
			request>headers delete
			request>tls delete
			resp_headers delete
			user_id delete
			bytes_read delete
			size delete
			duration delete
		}
	}

	# A problem report, sent by the app when the person asks (deploy/reports: the service on the
	# compose's inner network). Only there is anything posted.
	handle /api/report {
		request_body {
			max_size 16KB
		}
		reverse_proxy capriole-reports:8081
	}

	# The container's health probe.
	handle /healthz {
		respond "ok" 200
	}

	handle {
		file_server
	}
}
