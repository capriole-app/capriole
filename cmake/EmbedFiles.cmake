# Data built into the engine: capriole_embed_files(OUTPUT <cpp> FUNCTION <name> FILES <file>...) writes a
# C++ source defining
#     std::span<const unsigned char> <name>(std::size_t index)
# (namespace capriole::font::detail) that returns the bytes of the index-th file, empty past the last.
# Written at configure time from files that FetchContent has already downloaded and checked.
function(capriole_embed_files)
  cmake_parse_arguments(ARG "" "OUTPUT;FUNCTION" "FILES" ${ARGN})
  set(arrays "")
  set(cases "")
  set(index 0)
  foreach(file IN LISTS ARG_FILES)
    file(READ "${file}" hex HEX)
    string(LENGTH "${hex}" digits)
    math(EXPR size "${digits} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    get_filename_component(name "${file}" NAME)
    string(APPEND arrays "// ${name}\nconstexpr std::array<unsigned char, ${size}> kFile${index} = {${bytes}};\n")
    string(APPEND cases "    case ${index}:\n      return kFile${index};\n")
    math(EXPR index "${index} + 1")
  endforeach()
  set(content "// Generated by cmake/EmbedFiles.cmake — do not edit.\n// clang-format off\n#include <array>\n#include <cstddef>\n#include <span>\n\nnamespace capriole::font::detail {\n\nnamespace {\n\n${arrays}\n}  // namespace\n\nstd::span<const unsigned char> ${ARG_FUNCTION}(std::size_t index) {\n  switch (index) {\n${cases}    default:\n      return {};\n  }\n}\n\n}  // namespace capriole::font::detail\n")
  # Rewritten only when it changes: no rebuild at every configure.
  if(EXISTS "${ARG_OUTPUT}")
    file(READ "${ARG_OUTPUT}" previous)
  endif()
  if(NOT previous STREQUAL content)
    file(WRITE "${ARG_OUTPUT}" "${content}")
  endif()
endfunction()
